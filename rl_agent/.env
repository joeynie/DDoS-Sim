# Defender API 地址
# 在容器内使用: http://defender:5000
# 本地开发使用: http://localhost:5001
DEFENDER_URL=http://localhost:5001

# 模型保存路径
MODEL_PATH=./models/ppo_ddos_defense

# 训练步数
TRAINING_STEPS=5000

MODE=train  # 'inference'

# 采样间隔（秒）- 每个 step 之间的延迟
SAMPLING_INTERVAL=2

# 最大步数限制（每个 episode）
MAX_STEPS_PER_EPISODE=200

# 学习率 - PPO 算法的学习率
LEARNING_RATE=0.0003

# PPO 批次大小
BATCH_SIZE=64
